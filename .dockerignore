# Only what `go build ./cmd/server` needs reaches the build context. Anything
# else either leaks into the builder layer (.env, credentials) or busts the
# cache for no reason (docs, the site, CI files).

# VCS and editor state
.git
.gitignore
.gitattributes
.github/
.claude/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Local configuration and secrets — never in an image
.env
.env.*
*.pem
*.key
*.crt
ssl/

# Documentation and the docs site (docs/openapi.yaml and docs/embed.go are
# embedded in the binary, so docs/ itself stays)
*.md
site/

# Tooling not used by the build
Makefile
scripts/
deployments/
.golangci.yml
.mockery.yml
.air.toml
Dockerfile*
docker-compose*.yml
.dockerignore

# Tests
*_test.go
tests/
coverage.out
coverage.html
*.out

# Build artifacts and local data
bin/
dist/
data/
logs/
tmp/
uploads/
cache/
node_modules/
