# falco environment template. `make dev-setup` copies it to .env.
#
# As written it boots a local development instance: a filesystem bucket, no
# authentication. The "Production" section further down is what a real
# deployment needs; falco refuses to start on an inconsistent combination
# (API_KEY_REQUIRED without HMAC_REQUIRED or the reverse, a key that is not
# hex, a value that does not parse) instead of starting open.

# Server Configuration
PORT=8080
HOST=0.0.0.0
# Keep it below the orchestrator's grace period (Docker's default is 10s).
# SERVER_SHUTDOWN_TIMEOUT=8s

# Storage Configuration
# Default bucket name (must match a STORAGE_BUCKET_<NAME>_TYPE entry)
STORAGE_DEFAULT=local

# Buckets: auto-detected from STORAGE_BUCKET_<NAME>_TYPE env vars
# Simple filesystem bucket:
STORAGE_BUCKET_LOCAL_TYPE=filesystem
STORAGE_BUCKET_LOCAL_PATH=./data/images

# Jay bucket (what birdple-v2 runs on):
# STORAGE_BUCKET_JAY_TYPE=jay
# STORAGE_BUCKET_JAY_ADDR=jay:4012
# STORAGE_BUCKET_JAY_ADMIN_ADDR=jay:4010
# STORAGE_BUCKET_JAY_BUCKET=falco-images
# STORAGE_BUCKET_JAY_TOKEN_ID=your-token-id
# STORAGE_BUCKET_JAY_TOKEN_SECRET=your-token-secret

# S3 bucket example:
# STORAGE_BUCKET_IMAGES_TYPE=s3
# STORAGE_BUCKET_IMAGES_BUCKET=prod-images
# STORAGE_BUCKET_IMAGES_REGION=us-west-2
# STORAGE_BUCKET_IMAGES_ACCESS_KEY=your-access-key
# STORAGE_BUCKET_IMAGES_SECRET_KEY=your-secret-key

# S3-compatible endpoint (MinIO, Ceph, LocalStack): same s3 type, custom endpoint.
# The scheme in _ENDPOINT decides TLS; there is no separate flag.
# STORAGE_BUCKET_IMAGESBACKUP_TYPE=s3
# STORAGE_BUCKET_IMAGESBACKUP_BUCKET=backup-images
# STORAGE_BUCKET_IMAGESBACKUP_ENDPOINT=http://minio:9000
# STORAGE_BUCKET_IMAGESBACKUP_REGION=us-east-1
# STORAGE_BUCKET_IMAGESBACKUP_ACCESS_KEY=your-access-key
# STORAGE_BUCKET_IMAGESBACKUP_SECRET_KEY=your-secret-key

# R2 bucket example:
# STORAGE_BUCKET_CDN_TYPE=r2
# STORAGE_BUCKET_CDN_BUCKET=cdn-assets
# STORAGE_BUCKET_CDN_ACCOUNT_ID=your-cf-account-id
# STORAGE_BUCKET_CDN_ACCESS_KEY=your-r2-access-key
# STORAGE_BUCKET_CDN_SECRET_KEY=your-r2-secret-key

# Backup targets per bucket (N = 1,2,3...):
# STORAGE_BUCKET_IMAGES_BACKUP_1_TARGET=imagesbackup
# STORAGE_BUCKET_IMAGES_BACKUP_1_MODE=sync
# STORAGE_BUCKET_IMAGES_BACKUP_2_TARGET=cdn
# STORAGE_BUCKET_IMAGES_BACKUP_2_MODE=async

# Bucket aliases: names clients send that are not registry names (a hyphen
# cannot appear in STORAGE_BUCKET_<NAME>_*). alias=bucket pairs, comma-separated.
# STORAGE_BUCKET_ALIASES=birdple-dev=jay,birdple=jay

# Bucket-level API keys (use long random values: openssl rand -hex 32):
# STORAGE_BUCKET_IMAGES_KEY_CLIENTA_KEY=sk-client-a-secret
# STORAGE_BUCKET_IMAGES_KEY_CLIENTB_KEY=sk-client-b-secret

# Groups: organize buckets with shared keys
# STORAGE_GROUP_MEDIA_BUCKETS=images,imagesbackup,cdn
# STORAGE_GROUP_MEDIA_KEY_MEDIATEAM_KEY=sk-media-team-secret

# Subgroups (1 level deep, inherit parent group):
# STORAGE_GROUP_MEDIA_SUBGROUP_THUMBNAILS_BUCKETS=images
# STORAGE_GROUP_MEDIA_SUBGROUP_THUMBNAILS_KEY_THUMBSERVICE_KEY=sk-thumb-service

# Cache Configuration
# CACHE_SIZE_MB=0 disables the in-process cache.
CACHE_SIZE_MB=256
CACHE_TTL_HOURS=24
# Browser / CDN TTLs emitted in the Cache-Control of every served image.
# Left unset, the compiled default is 31536000 (1 year) for both. Uncomment
# only to shorten them in dev. Values below 86400 (browser) or 604800 (CDN)
# re-activate the >=1MB bump in serveImage(), see internal/api/handlers/base.go.
# CACHE_DEFAULT_MAX_AGE=31536000    # TTL for browser (seconds)
# CACHE_DEFAULT_SMAX_AGE=31536000   # TTL for CDN/Cloudflare (seconds)

# Redis Cache (shared across replicas)
ENABLE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# Processing Configuration
MAX_FILE_SIZE_MB=10
DEFAULT_QUALITY=80
DEFAULT_FORMAT=webp
CONCURRENT_WORKERS=4
# Largest decoded input or produced output, in megapixels.
MAX_MEGAPIXELS=100

# Security Configuration (development: open)
API_KEY_REQUIRED=false
HMAC_REQUIRED=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_RPM=1000

# --- Production ---------------------------------------------------------
# Both flags together: the API key protects the write endpoints and /sign,
# the HMAC signature protects delivery and the proxy.
# API_KEY_REQUIRED=true
# API_KEY=                     # openssl rand -hex 32
# HMAC_REQUIRED=true
# HMAC_KEY=                    # openssl rand -hex 32
# HMAC_SALT=                   # openssl rand -hex 32
# HMAC_SIGNATURE_SIZE=32       # 0 (full) or 16-32 bytes
# HMAC_REQUIRE_EXPIRY=true     # no default: delivery answers 500 without it
# TRUSTED_PROXIES=10.0.0.0/8   # the subnet of the proxy in front of falco
# COOKIE_SECURE=true           # panel cookies behind a TLS-terminating proxy
# -------------------------------------------------------------------------

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=text
LOG_OUTPUT=stdout

# Development Configuration
# ENABLE_PPROF mounts /debug/pprof/* (including Go 1.27's goroutineleak
# profile) and ENABLE_METRICS mounts /metrics. Both only behind the API key:
# with API_KEY_REQUIRED=false they are not mounted at all.
ENABLE_PPROF=false
ENABLE_METRICS=false

# Per-request header caps (tighter than the standard library's 1 MiB / 500
# values, because falco is a public-facing image CDN).
MAX_HEADER_BYTES=65536
MAX_HEADER_VALUE_COUNT=100

# Proxy endpoint — comma-separated list of allowed external hostnames.
# Requests to hosts not in this list are rejected with 403.
# Default (used when unset): BGG and Google user-content CDNs.
PROXY_ALLOWED_HOSTS=lh3.googleusercontent.com,lh4.googleusercontent.com,lh5.googleusercontent.com,lh6.googleusercontent.com,cf.geekdo-images.com,geekdo-images.com,boardgamegeek.com

# Watermarks from an external URL (?wm_url=). Without this variable external
# watermarks are REFUSED with 403: an empty list does not mean "any host". A
# watermark stored in falco itself (?wm=logos/mark) needs no configuration and
# no network access.
WATERMARK_ALLOWED_HOSTS=

# Maximum output width (px) when no w/h params are given. Height scales
# proportionally. Prevents serving full-resolution originals on cache miss.
PROXY_MAX_WIDTH=1200
