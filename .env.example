# Server Configuration
PORT=8080
HOST=0.0.0.0
ENV=development

# Storage Configuration
STORAGE_MODE=single              # "single" (default) or "multi" (named backends)
STORAGE_PRIMARY=filesystem       # filesystem, s3, minio, or r2
STORAGE_SECONDARY=none           # none, filesystem, s3, minio, or r2
STORAGE_REPLICATION=sync         # sync, async, or read-fallback (when secondary != none)
STORAGE_LOCAL_PATH=./data/images
STORAGE_S3_BUCKET=your-image-bucket
STORAGE_S3_REGION=us-west-2
STORAGE_S3_ACCESS_KEY=your-access-key
STORAGE_S3_SECRET_KEY=your-secret-key
STORAGE_MINIO_BUCKET=your-minio-bucket
STORAGE_MINIO_ENDPOINT=http://localhost:9000
STORAGE_MINIO_REGION=us-east-1
STORAGE_MINIO_ACCESS_KEY=minioadmin
STORAGE_MINIO_SECRET_KEY=minioadmin
STORAGE_MINIO_SECURE=false
STORAGE_R2_BUCKET=your-r2-bucket
STORAGE_R2_ACCOUNT_ID=your-cloudflare-account-id
STORAGE_R2_ACCESS_KEY=your-r2-access-key
STORAGE_R2_SECRET_KEY=your-r2-secret-key

# Multi mode: named backends (auto-detected from STORAGE_BACKEND_<NAME>_TYPE vars)
# Defining any STORAGE_BACKEND_*_TYPE var automatically sets STORAGE_MODE=multi
# STORAGE_DEFAULT=images           # Which named backend is the default
# STORAGE_BACKEND_IMAGES_TYPE=minio
# STORAGE_BACKEND_IMAGES_BUCKET=prod-images
# STORAGE_BACKEND_IMAGES_ENDPOINT=minio:9000
# STORAGE_BACKEND_IMAGES_ACCESS_KEY=minioadmin
# STORAGE_BACKEND_IMAGES_SECRET_KEY=minioadmin
# STORAGE_BACKEND_BACKUPS_TYPE=s3
# STORAGE_BACKEND_BACKUPS_BUCKET=backup-bucket
# STORAGE_BACKEND_BACKUPS_REGION=us-east-1
# STORAGE_BACKEND_BACKUPS_ACCESS_KEY=your-access-key
# STORAGE_BACKEND_BACKUPS_SECRET_KEY=your-secret-key
# STORAGE_BACKEND_CDN_TYPE=r2
# STORAGE_BACKEND_CDN_BUCKET=cdn-assets
# STORAGE_BACKEND_CDN_ACCOUNT_ID=your-cf-account-id
# STORAGE_BACKEND_CDN_ACCESS_KEY=your-r2-access-key
# STORAGE_BACKEND_CDN_SECRET_KEY=your-r2-secret-key

# Cache Configuration
CACHE_SIZE_MB=256
CACHE_TTL_HOURS=24
CACHE_DEFAULT_MAX_AGE=3600    # TTL for browser (seconds)
CACHE_DEFAULT_SMAX_AGE=7200   # TTL for CDN/Cloudflare (seconds)

# Redis Cache (Persistent)
ENABLE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# Processing Configuration
MAX_FILE_SIZE_MB=10
DEFAULT_QUALITY=80
DEFAULT_FORMAT=webp
CONCURRENT_WORKERS=4

# Security Configuration
API_KEY_REQUIRED=true
API_KEY=your-api-key
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_RPM=1000

# Scoped API Keys (restrict access per client to specific storages/buckets)
# Auto-detected from SCOPED_KEY_<NAME>_KEY env vars
# SCOPED_KEY_CLIENTA_KEY=sk-client-a-secret
# SCOPED_KEY_CLIENTA_STORAGES=images
# SCOPED_KEY_CLIENTA_BUCKETS=client-a-bucket,client-a-assets
# SCOPED_KEY_CLIENTB_KEY=sk-client-b-secret
# SCOPED_KEY_CLIENTB_BUCKETS=client-b-uploads

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=text
LOG_OUTPUT=stdout

# Development Configuration
DEBUG=false
ENABLE_PPROF=false

ENABLE_METRICS=true

# HMAC URL Signing (optional but strongly recommended for production)
# Generate with: openssl rand -hex 32
HMAC_KEY=
HMAC_SALT=
HMAC_SIGNATURE_SIZE=32
HMAC_REQUIRED=false