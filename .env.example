# Server Configuration
PORT=8080
HOST=0.0.0.0
ENV=development

# Storage Configuration
STORAGE_PRIMARY=filesystem #filesystem, s3, or minio
STORAGE_SECONDARY=none
STORAGE_LOCAL_PATH=./data/images
STORAGE_S3_BUCKET=your-image-bucket
STORAGE_S3_REGION=us-west-2
STORAGE_S3_ACCESS_KEY=your-access-key
STORAGE_S3_SECRET_KEY=your-secret-key
STORAGE_MINIO_BUCKET=your-minio-bucket
STORAGE_MINIO_ENDPOINT=http://localhost:9000
STORAGE_MINIO_REGION=us-east-1
STORAGE_MINIO_ACCESS_KEY=minioadmin
STORAGE_MINIO_SECRET_KEY=minioadmin
STORAGE_MINIO_SECURE=false

# Cache Configuration
CACHE_SIZE_MB=256
CACHE_TTL_HOURS=24
CACHE_DEFAULT_MAX_AGE=3600    # TTL for browser (seconds)
CACHE_DEFAULT_SMAX_AGE=7200   # TTL for CDN/Cloudflare (seconds)

# Redis Cache (Persistent)
ENABLE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# Processing Configuration
MAX_FILE_SIZE_MB=10
DEFAULT_QUALITY=80
DEFAULT_FORMAT=webp
CONCURRENT_WORKERS=4

# Security Configuration
API_KEY_REQUIRED=true
API_KEY=your-api-key
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_RPM=1000

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=text
LOG_OUTPUT=stdout

# Development Configuration
DEBUG=false
ENABLE_PPROF=false

ENABLE_METRICS=true