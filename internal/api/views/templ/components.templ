package views

import "fmt"

// --- feedback ---

// Toasts is the notification area. Messages are pushed by app.js, which is the
// only place errors surface: the old panel used alert() for upload failures and
// showed nothing at all for a failed delete.
templ Toasts() {
	<div class="fixed bottom-5 right-5 z-[200] flex flex-col gap-2 w-[22rem] max-w-[calc(100vw-2.5rem)]" x-cloak>
		<template x-for="t in toasts" :key="t.id">
			<div
				class="rounded-xl border shadow-lg backdrop-blur-md px-4 py-3 text-sm"
				:class="t.ok
					? 'bg-emerald-50/95 border-emerald-200 text-emerald-900 dark:bg-emerald-500/10 dark:border-emerald-500/25 dark:text-emerald-200'
					: 'bg-red-50/95 border-red-200 text-red-900 dark:bg-red-500/10 dark:border-red-500/25 dark:text-red-200'"
			>
				<div class="flex items-start gap-2">
					<div class="flex-1 min-w-0">
						<p class="font-semibold" x-text="t.title"></p>
						<p class="mt-0.5 opacity-80 break-words" x-show="t.detail" x-text="t.detail"></p>
						<ul class="mt-1.5 space-y-0.5 opacity-90" x-show="t.failed && t.failed.length">
							<template x-for="f in t.failed" :key="f.name">
								<li class="text-xs font-mono break-all">
									<span x-text="f.name"></span>: <span x-text="f.reason"></span>
								</li>
							</template>
						</ul>
					</div>
					<button class="opacity-50 hover:opacity-100 shrink-0" @click="dismissToast(t.id)" aria-label="Dismiss">
						@iconClose(14)
					</button>
				</div>
			</div>
		</template>
	</div>
}

// InlineError is the error fragment HTMX swaps in when a partial fails.
templ InlineError(message string) {
	<div class="p-4 bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/25 rounded-xl flex items-start gap-3">
		<div class="text-red-500 dark:text-red-400 shrink-0 mt-0.5">@iconAlert()</div>
		<div class="min-w-0">
			<h4 class="font-semibold text-red-700 dark:text-red-300 text-sm">Something went wrong</h4>
			<p class="text-red-600 dark:text-red-400/90 text-sm mt-0.5 break-words">{ message }</p>
		</div>
	</div>
}

// Notice is a neutral explanatory banner — used where a capability is missing
// and the reason matters more than the failure.
templ Notice(title, message string) {
	<div class="p-4 bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/25 rounded-xl flex items-start gap-3">
		<div class="text-amber-500 dark:text-amber-400 shrink-0 mt-0.5">@iconInfo()</div>
		<div class="min-w-0">
			<h4 class="font-semibold text-amber-800 dark:text-amber-300 text-sm">{ title }</h4>
			<p class="text-amber-700 dark:text-amber-400/90 text-sm mt-0.5">{ message }</p>
		</div>
	</div>
}

// --- small pieces ---

templ StatusDot(ok bool) {
	if ok {
		<span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
	} else {
		<span class="w-2 h-2 rounded-full bg-red-500 shrink-0"></span>
	}
}

templ Chip(label string) {
	<span class="px-2 py-0.5 rounded-md bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 text-[10px] font-semibold uppercase tracking-wider">{ label }</span>
}

templ BackupChip(b BackupItem) {
	<span class="inline-flex items-center gap-1 text-[10px] text-neutral-500 dark:text-neutral-500">
		<span class="font-mono">{ b.Target }</span>
		<span class={ "px-1 py-px rounded text-[9px] font-bold uppercase tracking-wider",
			templ.KV("bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300", b.Mode == "sync"),
			templ.KV("bg-sky-100 text-sky-700 dark:bg-sky-500/15 dark:text-sky-300", b.Mode == "async"),
			templ.KV("bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300", b.Mode == "read-fallback") }>
			{ b.Mode }
		</span>
	</span>
}

// EmptyState is shown when a prefix holds nothing.
templ EmptyState(canUpload bool) {
	<div class="col-span-full py-16 flex flex-col items-center justify-center text-center border-2 border-dashed border-neutral-200 dark:border-neutral-800 rounded-2xl">
		<div class="w-14 h-14 bg-neutral-100 dark:bg-neutral-900 rounded-full flex items-center justify-center mb-4 text-neutral-400 dark:text-neutral-600">
			@iconImage(26)
		</div>
		<h3 class="text-base font-semibold mb-1">Nothing here</h3>
		<p class="text-neutral-500 dark:text-neutral-400 max-w-sm text-sm">This location has no objects.</p>
		if canUpload {
			<button @click="showUpload = true" class="mt-5 bg-neutral-900 dark:bg-neutral-100 dark:text-neutral-900 hover:opacity-90 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-opacity">
				Upload something
			</button>
		}
	</div>
}

// Pagination renders the cursor controls.
//
// When the backend cannot page it says so instead of drawing buttons that would
// silently re-fetch the same first page.
templ Pagination(data ExplorerData) {
	if !data.Paginated {
		<div class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-500">
			@iconInfo()
			<span>This backend lists everything at once — no pagination available.</span>
		</div>
	} else if data.HasPrev || data.NextCursor != "" {
		<div class="flex items-center gap-2">
			if data.HasPrev {
				<button
					hx-get={ explorerURL(data.Bucket, data.Prefix, "", popCursor(data.CursorStack)) }
					hx-target="#explorer"
					hx-swap="outerHTML"
					hx-push-url="true"
					class="px-3 py-1.5 rounded-lg border border-neutral-200 dark:border-neutral-700 text-sm font-medium hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
				>
					Previous
				</button>
			}
			if data.NextCursor != "" {
				<button
					hx-get={ explorerURL(data.Bucket, data.Prefix, data.NextCursor, pushCursor(data.CursorStack, data.NextCursor)) }
					hx-target="#explorer"
					hx-swap="outerHTML"
					hx-push-url="true"
					class="px-3 py-1.5 rounded-lg border border-neutral-200 dark:border-neutral-700 text-sm font-medium hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
				>
					Next
				</button>
			}
		</div>
	}
}

// --- icons ---
// Inline so the panel needs no icon font and no external request.

templ iconSun() {
	<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
}

templ iconMoon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
}

templ iconLogout() {
	<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" x2="9" y1="12" y2="12"></line></svg>
}

templ iconClose(size int) {
	<svg xmlns="http://www.w3.org/2000/svg" width={ fmt.Sprintf("%d", size) } height={ fmt.Sprintf("%d", size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
}

templ iconAlert() {
	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
}

templ iconInfo() {
	<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
}

templ iconImage(size int) {
	<svg xmlns="http://www.w3.org/2000/svg" width={ fmt.Sprintf("%d", size) } height={ fmt.Sprintf("%d", size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path></svg>
}

templ iconFolder() {
	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"></path></svg>
}

templ iconTrash(size int) {
	<svg xmlns="http://www.w3.org/2000/svg" width={ fmt.Sprintf("%d", size) } height={ fmt.Sprintf("%d", size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
}

templ iconUpload(size int) {
	<svg xmlns="http://www.w3.org/2000/svg" width={ fmt.Sprintf("%d", size) } height={ fmt.Sprintf("%d", size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg>
}

templ iconCopy() {
	<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"></rect><path d="M4 16V4a2 2 0 0 1 2-2h10"></path></svg>
}

templ iconSliders() {
	<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="4" y1="21" y2="14"></line><line x1="4" x2="4" y1="10" y2="3"></line><line x1="12" x2="12" y1="21" y2="12"></line><line x1="12" x2="12" y1="8" y2="3"></line><line x1="20" x2="20" y1="21" y2="16"></line><line x1="20" x2="20" y1="12" y2="3"></line><line x1="2" x2="6" y1="14" y2="14"></line><line x1="10" x2="14" y1="8" y2="8"></line><line x1="18" x2="22" y1="16" y2="16"></line></svg>
}
