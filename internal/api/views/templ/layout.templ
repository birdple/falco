package views

// Layout is the page shell.
//
// The theme class is decided on the server from a cookie, so the first paint is
// already correct. The old panel did it with an inline <script>, which the
// panel's own CSP (script-src 'self' 'unsafe-eval' — no 'unsafe-inline')
// blocked outright, so every load flashed the light theme.
templ Layout(page PageData) {
	<!DOCTYPE html>
	<html lang="en" class={ "h-full", templ.KV("dark", page.IsDark()) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ page.Title } · falco</title>
			<meta name="csrf-token" content={ page.CSRFToken }/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/app.js"></script>
			<script defer src="/static/js/alpine.min.js"></script>
		</head>
		<body
			class="h-screen flex flex-col overflow-hidden bg-neutral-50 text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100 selection:bg-violet-500/30"
			x-data="falcoApp()"
			@upload-finished.window="onUploadFinished($event.detail)"
		>
			{ children... }
			@Toasts()
		</body>
	</html>
}

// Shell wraps the authenticated pages: nav on top, page below.
templ Shell(page PageData) {
	@Layout(page) {
		@Nav(page)
		<main class="flex-1 flex overflow-hidden relative">
			{ children... }
		</main>
	}
}

templ Nav(page PageData) {
	<nav class="shrink-0 px-5 h-14 flex items-center justify-between border-b border-neutral-200 dark:border-neutral-800 bg-white/90 dark:bg-neutral-900/90 backdrop-blur-xl">
		<div class="flex items-center gap-6">
			<a href="/dashboard" class="flex items-center gap-2.5 group">
				<div class="w-8 h-8 bg-violet-600 rounded-lg flex items-center justify-center text-base font-bold text-white shadow-sm shadow-violet-500/25 group-hover:bg-violet-500 transition-colors">f</div>
				<span class="text-base font-semibold tracking-tight">falco</span>
			</a>
			<div class="hidden md:flex items-center gap-1">
				@navLink("/dashboard", "Storage", page.CurrentPage == "explorer")
				@navLink("/playground", "Playground", page.CurrentPage == "playground")
				@navLink("/signer", "Sign URL", page.CurrentPage == "signer")
				@navLink("/ops", "Operations", page.CurrentPage == "ops")
			</div>
		</div>
		<div class="flex items-center gap-2">
			if page.KeyName != "" {
				<div class="hidden sm:flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400 mr-1">
					<span class="font-medium text-neutral-700 dark:text-neutral-300">{ page.KeyName }</span>
					if page.IsAdmin {
						<span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300 text-[10px] font-bold uppercase tracking-widest">admin</span>
					} else {
						<span class="px-1.5 py-0.5 rounded bg-sky-100 text-sky-700 dark:bg-sky-500/15 dark:text-sky-300 text-[10px] font-bold uppercase tracking-widest">scoped</span>
					}
				</div>
			}
			<button
				@click="toggleTheme()"
				class="p-2 rounded-lg text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
				title="Toggle theme"
				aria-label="Toggle theme"
			>
				<template x-if="dark">
					<span>@iconSun()</span>
				</template>
				<template x-if="!dark">
					<span>@iconMoon()</span>
				</template>
			</button>
			<a href="/docs" class="hidden sm:block px-2.5 py-1.5 rounded-lg text-sm font-medium text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">Docs</a>
			<button
				@click="logout()"
				class="p-2 rounded-lg text-neutral-400 hover:text-red-500 dark:hover:text-red-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
				title="Sign out"
				aria-label="Sign out"
			>
				@iconLogout()
			</button>
		</div>
	</nav>
}

templ navLink(href, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		class={ "px-3 py-1.5 rounded-lg text-sm font-medium transition-colors",
			templ.KV("bg-violet-50 text-violet-700 dark:bg-violet-500/15 dark:text-violet-300", active),
			templ.KV("text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800", !active) }
	>
		{ label }
	</a>
}
