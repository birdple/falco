package views

// LoginPage is the sign-in screen.
//
// It has a third state besides "form" and "error": Disabled. With no API key
// configured there is nothing to authenticate against, and the old panel's
// answer to that was to invent an admin scope and let anyone in. Refusing, and
// saying which variable to set, is the only correct answer.
templ LoginPage(data LoginData) {
	<!DOCTYPE html>
	<html lang="en" class={ "h-full", templ.KV("dark", data.IsDark()) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Sign in · falco</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/app.js"></script>
			<script defer src="/static/js/alpine.min.js"></script>
		</head>
		<body class="h-screen flex items-center justify-center bg-neutral-50 dark:bg-neutral-950 text-neutral-900 dark:text-neutral-100 px-5">
			<div class="w-full max-w-sm">
				<div class="flex flex-col items-center mb-8">
					<div class="w-12 h-12 bg-violet-600 rounded-2xl flex items-center justify-center text-xl font-bold text-white shadow-lg shadow-violet-500/25 mb-4">f</div>
					<h1 class="text-xl font-semibold tracking-tight">falco</h1>
					<p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">Image processing and delivery</p>
				</div>

				if data.Disabled {
					<div class="rounded-2xl border border-amber-200 dark:border-amber-500/25 bg-amber-50 dark:bg-amber-500/10 p-5">
						<div class="flex items-start gap-3">
							<div class="text-amber-500 dark:text-amber-400 mt-0.5">@iconAlert()</div>
							<div>
								<h2 class="font-semibold text-amber-800 dark:text-amber-300 text-sm">Panel disabled</h2>
								<p class="text-sm text-amber-700 dark:text-amber-400/90 mt-1">{ data.Error }</p>
							</div>
						</div>
					</div>
				} else {
					<form
						class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-6 shadow-sm"
						x-data="loginForm()"
						@submit.prevent="submit()"
					>
						<label for="key" class="block text-sm font-medium mb-2">API key</label>
						<input
							id="key"
							name="key"
							type="password"
							autocomplete="current-password"
							required
							x-model="key"
							x-ref="key"
							class="w-full bg-neutral-50 dark:bg-neutral-950 border border-neutral-300 dark:border-neutral-700 rounded-lg px-3 py-2.5 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-violet-500/40 focus:border-violet-500"
							placeholder="••••••••••••••••"
						/>
						if data.Error != "" {
							<p class="mt-3 text-sm text-red-600 dark:text-red-400">{ data.Error }</p>
						}
						<p class="mt-3 text-sm text-red-600 dark:text-red-400" x-show="error" x-text="error" x-cloak></p>
						<button
							type="submit"
							:disabled="busy || !key"
							class="mt-5 w-full bg-violet-600 hover:bg-violet-500 disabled:bg-neutral-300 dark:disabled:bg-neutral-800 disabled:cursor-not-allowed text-white py-2.5 rounded-lg text-sm font-semibold transition-colors"
						>
							<span x-text="busy ? 'Signing in…' : 'Sign in'"></span>
						</button>
					</form>
					<p class="mt-4 text-center text-xs text-neutral-400 dark:text-neutral-600">
						The key is exchanged for a session cookie and is never stored in the browser.
					</p>
				}
			</div>
		</body>
	</html>
}
