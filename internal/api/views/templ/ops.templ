package views

import "fmt"

// OpsPage is the operations screen: what is running, what is broken, and what
// is switched off because it was never configured.
templ OpsPage(data OpsData) {
	@Shell(data.Page) {
		<div class="flex-1 h-full overflow-y-auto">
			<div class="p-6 lg:p-8 max-w-6xl mx-auto space-y-6">
				<div class="flex items-start justify-between gap-4 flex-wrap">
					<div>
						<h1 class="text-xl font-semibold tracking-tight">Operations</h1>
						<p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">
							falco { data.Version } · up { data.Uptime } · { fmt.Sprintf("%d active session(s)", data.Sessions) }
						</p>
					</div>
					<div class={ "px-3 py-1.5 rounded-lg text-sm font-semibold",
						templ.KV("bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300", data.Status == "ready"),
						templ.KV("bg-red-100 text-red-700 dark:bg-red-500/15 dark:text-red-300", data.Status != "ready") }>
						{ data.Status }
					</div>
				</div>

				<!-- Storage backends -->
				<section class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 overflow-hidden">
					<header class="px-5 py-3 border-b border-neutral-200 dark:border-neutral-800">
						<h2 class="text-sm font-semibold">Storage backends</h2>
					</header>
					<div class="divide-y divide-neutral-100 dark:divide-neutral-800">
						for _, b := range data.Backends {
							<div class="px-5 py-3.5 flex items-start justify-between gap-4 flex-wrap">
								<div class="min-w-0">
									<div class="flex items-center gap-2">
										@StatusDot(b.OK)
										<span class="font-medium text-sm">{ b.Name }</span>
										@Chip(b.Type)
										if b.Breaker != "" && b.Breaker != "closed" {
											<span class="px-1.5 py-0.5 rounded bg-red-100 text-red-700 dark:bg-red-500/15 dark:text-red-300 text-[10px] font-bold uppercase tracking-wider">
												breaker { b.Breaker }
											</span>
										}
										if !b.Paginated {
											<span class="px-1.5 py-0.5 rounded bg-neutral-100 text-neutral-500 dark:bg-neutral-800 dark:text-neutral-400 text-[10px] font-semibold uppercase tracking-wider" title="The explorer cannot page through this backend">
												no paging
											</span>
										}
									</div>
									if b.Error != "" {
										<p class="mt-1 text-xs text-red-600 dark:text-red-400 break-words">{ b.Error }</p>
									}
									if len(b.Backups) > 0 {
										<div class="mt-1.5 flex flex-wrap gap-2">
											for _, bk := range b.Backups {
												@BackupChip(bk)
											}
										</div>
									}
								</div>
								<div class="text-right text-sm shrink-0">
									if b.Objects != nil {
										<p class="font-medium">{ fmt.Sprintf("%d objects", *b.Objects) }</p>
										<p class="text-xs text-neutral-500 dark:text-neutral-500">{ b.SizeHuman }</p>
									} else {
										<p class="text-xs text-neutral-400 dark:text-neutral-600">stats unavailable</p>
									}
									if b.HasFree {
										<p class="text-xs text-neutral-500 dark:text-neutral-500">{ b.FreeHuman } free</p>
									}
								</div>
							</div>
						}
					</div>
				</section>

				<div class="grid lg:grid-cols-2 gap-6">
					<!-- Cache -->
					<section class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 overflow-hidden">
						<header class="px-5 py-3 border-b border-neutral-200 dark:border-neutral-800 flex items-center justify-between">
							<h2 class="text-sm font-semibold">Transform cache</h2>
							if data.Cache.Enabled {
								<button
									@click="purgeCache()"
									class="px-2.5 py-1.5 rounded-lg text-xs font-semibold border border-red-200 dark:border-red-500/30 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors"
								>
									Purge all
								</button>
							}
						</header>
						<div class="p-5">
							if !data.Cache.Enabled {
								<p class="text-sm text-neutral-500 dark:text-neutral-400">
									Caching is off (CACHE_SIZE_MB is 0). Every transformation is recomputed on each request.
								</p>
							} else {
								<div class="grid grid-cols-2 gap-4 mb-4">
									@statTile("Hit ratio", fmt.Sprintf("%.1f%%", data.Cache.HitRatio*100))
									@statTile("Items", fmt.Sprintf("%d", data.Cache.ItemCount))
									@statTile("Hits", fmt.Sprintf("%d", data.Cache.Hits))
									@statTile("Misses", fmt.Sprintf("%d", data.Cache.Misses))
								</div>
								<div class="mb-1.5 flex items-center justify-between text-xs text-neutral-500 dark:text-neutral-400">
									<span>{ data.Cache.SizeHuman } of { data.Cache.MaxHuman }</span>
									<span>{ fmt.Sprintf("%.0f%%", data.Cache.UsedPercent) }</span>
								</div>
								<div class="h-1.5 bg-neutral-200 dark:bg-neutral-800 rounded-full overflow-hidden">
									<div class="h-full bg-violet-500 rounded-full" style={ fmt.Sprintf("width: %.1f%%", min(data.Cache.UsedPercent, 100)) }></div>
								</div>
								<dl class="mt-4 space-y-1.5 text-xs">
									@metaRow("Backend", data.Cache.Backend)
									@metaRow("TTL", fmt.Sprintf("%d h", data.Cache.TTLHours))
									@metaRow("Sweep interval", data.Cache.CleanupInterval)
								</dl>
								<p class="mt-3 text-[11px] text-neutral-400 dark:text-neutral-600">{ data.Cache.Note }</p>
							}
						</div>
					</section>

					<!-- Features -->
					<section class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 overflow-hidden">
						<header class="px-5 py-3 border-b border-neutral-200 dark:border-neutral-800">
							<h2 class="text-sm font-semibold">Features</h2>
						</header>
						<div class="divide-y divide-neutral-100 dark:divide-neutral-800">
							for _, f := range data.Features {
								<div class="px-5 py-3">
									<div class="flex items-center gap-2">
										@StatusDot(f.Enabled)
										<span class="text-sm font-medium">{ f.Name }</span>
									</div>
									if !f.Enabled && f.Reason != "" {
										<p class="mt-1 pl-4 text-xs text-neutral-500 dark:text-neutral-500">{ f.Reason }</p>
									}
								</div>
							}
						</div>
					</section>
				</div>

				<!-- Effective configuration -->
				<section class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 overflow-hidden">
					<header class="px-5 py-3 border-b border-neutral-200 dark:border-neutral-800">
						<h2 class="text-sm font-semibold">Effective configuration</h2>
						<p class="text-xs text-neutral-500 dark:text-neutral-500 mt-0.5">
							Secrets are reported as set or not set, never shown.
						</p>
					</header>
					<div class="p-5 grid sm:grid-cols-2 gap-x-8 gap-y-2">
						for _, c := range data.Config {
							<div class="flex items-start justify-between gap-4 text-sm">
								<span class="text-neutral-500 dark:text-neutral-400 font-mono text-xs">{ c.Name }</span>
								if c.Secret {
									<span class={ "font-semibold text-xs",
										templ.KV("text-emerald-600 dark:text-emerald-400", c.Value == "set"),
										templ.KV("text-neutral-400 dark:text-neutral-600", c.Value != "set") }>
										{ c.Value }
									</span>
								} else {
									<span class="font-medium text-right break-all">{ c.Value }</span>
								}
							</div>
						}
					</div>
				</section>

				if data.MetricsEnabled {
					<p class="text-xs text-neutral-400 dark:text-neutral-600">
						Prometheus metrics are exposed at <code class="font-mono">/metrics</code> behind the admin API key.
					</p>
				}
			</div>
		</div>
	}
}

templ statTile(label, value string) {
	<div class="rounded-xl bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 px-3 py-2.5">
		<p class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-600">{ label }</p>
		<p class="text-lg font-semibold tabular-nums mt-0.5">{ value }</p>
	</div>
}
