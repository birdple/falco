package views

import "fmt"

// Sidebar lists the buckets this key can reach.
templ Sidebar(data ExplorerData) {
	<aside class="w-60 shrink-0 border-r border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 h-full overflow-y-auto hidden md:block">
		<div id="sidebar-body" class="p-4">
			@SidebarBody(data)
		</div>
	</aside>
}

// SidebarOOB re-renders the sidebar during an HTMX swap of the main area.
//
// Without this the sidebar keeps highlighting the bucket you navigated away
// from — the old panel targeted only #main-content and nothing ever refreshed
// the list.
templ SidebarOOB(data ExplorerData) {
	<div id="sidebar-body" hx-swap-oob="innerHTML" class="p-4">
		@SidebarBody(data)
	</div>
}

templ SidebarBody(data ExplorerData) {
	<h3 class="text-[11px] font-semibold uppercase tracking-widest text-neutral-400 dark:text-neutral-600 mb-2 px-2">Buckets</h3>
	<div class="space-y-0.5">
		for _, b := range data.Page.Buckets {
			<button
				hx-get={ explorerURL(b.Name, "", "", "") }
				hx-target="#explorer"
				hx-swap="outerHTML"
				hx-push-url="true"
				class={ "w-full flex items-center justify-between gap-2 px-2.5 py-2 rounded-lg transition-colors text-left",
					templ.KV("bg-violet-50 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300", b.Name == data.Bucket),
					templ.KV("hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-600 dark:text-neutral-400", b.Name != data.Bucket) }
			>
				<span class="flex items-center gap-2 min-w-0">
					if b.Healthy != nil {
						@StatusDot(*b.Healthy)
					}
					<span class="flex flex-col min-w-0">
						<span class="text-sm truncate font-medium">{ b.Name }</span>
						<span class="text-[10px] uppercase tracking-wider text-neutral-400 dark:text-neutral-600 leading-tight">
							{ b.Type }
							if b.IsDefault {
								<span> · default</span>
							}
						</span>
					</span>
				</span>
				<span
					class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-500 shrink-0"
					if b.Error != "" {
						title={ b.Error }
					}
				>
					{ b.CountLabel() }
				</span>
			</button>
			if len(b.Backups) > 0 {
				<div class="pl-4 pb-1 flex flex-col gap-0.5">
					for _, bk := range b.Backups {
						@BackupChip(bk)
					}
				</div>
			}
		}
	</div>

	if data.Stats != nil && data.Stats.StatsError != "" {
		<p class="mt-3 px-2 text-[11px] text-amber-600 dark:text-amber-400">
			Some counts are unavailable — the backend could not be reached.
		</p>
	}
}

// UploadModal is the upload dialog.
//
// Every limit shown here comes from the live configuration. The old dialog had
// "PNG, JPG, WebP up to 10MB" written into the markup while MAX_FILE_SIZE_MB
// was configurable and the accepted list was a different one.
templ UploadModal(data ExplorerData) {
	<div
		x-show="showUpload"
		x-cloak
		style="display:none"
		x-transition.opacity
		class="fixed inset-0 z-90 flex items-center justify-center bg-black/40 dark:bg-black/65 backdrop-blur-sm p-5"
		@click.self="showUpload = false"
		@keydown.escape.window="showUpload = false"
	>
		<div class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-2xl p-6 w-full max-w-lg shadow-xl" x-data={ fmt.Sprintf("uploadForm('%s', '%s')", data.Bucket, data.Prefix) }>
			<div class="flex items-center justify-between mb-5">
				<h3 class="text-lg font-semibold">Upload</h3>
				<button @click="showUpload = false" class="p-1 rounded-lg text-neutral-400 hover:text-neutral-700 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors" aria-label="Close">
					@iconClose(18)
				</button>
			</div>

			<form @submit.prevent="upload()">
				<div class="grid grid-cols-2 gap-3 mb-4">
					<div>
						<label class="block text-sm font-medium mb-1.5" for="up-bucket">Bucket</label>
						<select
							id="up-bucket"
							x-model="bucket"
							class="w-full bg-neutral-50 dark:bg-neutral-950 border border-neutral-300 dark:border-neutral-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-violet-500/40"
						>
							for _, b := range data.Upload.Buckets {
								<option value={ b } selected?={ b == data.Upload.Bucket }>{ b }</option>
							}
						</select>
					</div>
					<div>
						<label class="block text-sm font-medium mb-1.5" for="up-prefix">Folder</label>
						<input
							id="up-prefix"
							type="text"
							x-model="prefix"
							placeholder="avatars/"
							class="w-full bg-neutral-50 dark:bg-neutral-950 border border-neutral-300 dark:border-neutral-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-violet-500/40"
						/>
					</div>
				</div>

				<div
					class="mb-4 border-2 border-dashed border-neutral-300 dark:border-neutral-700 rounded-xl p-6 text-center transition-colors cursor-pointer"
					:class="{ 'border-violet-500 bg-violet-50 dark:bg-violet-500/5': dragover }"
					@click="$refs.file.click()"
					@dragover.prevent="dragover = true"
					@dragleave.prevent="dragover = false"
					@drop.prevent="onDrop($event)"
				>
					<input
						type="file"
						x-ref="file"
						@change="onSelect($event)"
						accept={ data.Upload.AcceptAttr }
						class="hidden"
						multiple
					/>
					<template x-if="!files.length">
						<div>
							<div class="mx-auto text-neutral-400 dark:text-neutral-600 mb-2 w-fit">@iconUpload(32)</div>
							<p class="text-sm text-neutral-600 dark:text-neutral-400">Drop files here or <span class="text-violet-600 dark:text-violet-400 font-medium">browse</span></p>
							<p class="text-xs text-neutral-400 dark:text-neutral-600 mt-1">{ data.Upload.AcceptLabel }</p>
						</div>
					</template>
					<template x-if="files.length">
						<div>
							<p class="text-sm font-medium" x-text="files.length + ' file(s) selected'"></p>
							<p class="text-xs text-neutral-500 dark:text-neutral-500 mt-1 break-all" x-text="files.map(f => f.name).join(', ')"></p>
						</div>
					</template>
				</div>

				<!-- Per-file results. A batch can partly fail, and the panel has
				     to say which ones did rather than report a blanket success. -->
				<template x-if="results.length">
					<ul class="mb-4 space-y-1 max-h-40 overflow-y-auto">
						<template x-for="r in results" :key="r.name">
							<li class="flex items-start gap-2 text-xs">
								<span :class="r.ok ? 'text-emerald-500' : 'text-red-500'" x-text="r.ok ? '✓' : '✗'"></span>
								<span class="font-mono break-all flex-1" x-text="r.name"></span>
								<span class="text-neutral-500 dark:text-neutral-500 break-words" x-text="r.message"></span>
							</li>
						</template>
					</ul>
				</template>

				<template x-if="busy">
					<div class="mb-4">
						<div class="h-1.5 bg-neutral-200 dark:bg-neutral-800 rounded-full overflow-hidden">
							<div class="h-full bg-violet-500 rounded-full transition-all duration-300" :style="'width: ' + progress + '%'"></div>
						</div>
						<p class="text-xs text-neutral-500 mt-1 text-center" x-text="progress + '%'"></p>
					</div>
				</template>

				<button
					type="submit"
					:disabled="!files.length || busy"
					class="w-full bg-violet-600 hover:bg-violet-500 disabled:bg-neutral-300 dark:disabled:bg-neutral-800 disabled:cursor-not-allowed text-white py-2.5 rounded-lg text-sm font-semibold transition-colors"
				>
					<span x-text="busy ? 'Uploading…' : 'Upload'"></span>
				</button>
			</form>
		</div>
	</div>
}
