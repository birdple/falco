package views

import "fmt"

templ Sidebar(data DashboardData) {
	<aside class="w-64 flex-shrink-0 border-r border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 flex flex-col h-full overflow-y-auto hidden md:flex transition-colors">
		<div class="p-5 space-y-6">
			<!-- Bucket Selector -->
			<div>
				<h3 class="font-semibold text-gray-400 dark:text-gray-500 text-[11px] tracking-widest uppercase mb-3 px-2">Storage</h3>
				<div class="space-y-0.5">
					for _, b := range data.Page.Buckets {
						<button
							hx-get={ fmt.Sprintf("/ui/content?bucket=%s", b.Name) }
							hx-target="#main-content"
							hx-push-url={ fmt.Sprintf("/dashboard?bucket=%s", b.Name) }
							class={ "w-full flex items-center justify-between px-3 py-2 rounded-lg transition-all group text-left",
								templ.KV("bg-violet-50 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 font-medium", b.Name == data.CurrentBucket),
								templ.KV("text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-200", b.Name != data.CurrentBucket) }>
							<div class="flex items-center gap-2.5">
								@bucketIcon(b.Type, b.Name == data.CurrentBucket)
								<div class="flex flex-col min-w-0">
									<span class="text-sm truncate">{ b.Name }</span>
									<span class={ "text-[10px] uppercase tracking-wider leading-none",
										templ.KV("text-violet-400 dark:text-violet-400/60", b.Name == data.CurrentBucket),
										templ.KV("text-gray-400 dark:text-gray-600", b.Name != data.CurrentBucket) }>{ b.Type }</span>
								</div>
							</div>
							if b.ImageCount > 0 {
								<span class={ "text-[10px] font-mono px-1.5 py-0.5 rounded-md transition-colors",
									templ.KV("bg-violet-100 dark:bg-violet-500/20 text-violet-600 dark:text-violet-300", b.Name == data.CurrentBucket),
									templ.KV("bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-500", b.Name != data.CurrentBucket) }>
									{ fmt.Sprintf("%d", b.ImageCount) }
								</span>
							}
						</button>
						<!-- Backup indicators -->
						if len(b.Backups) > 0 {
							for _, bk := range b.Backups {
								<div class="ml-9 flex items-center gap-1.5 text-[10px] text-gray-400 dark:text-gray-600 py-0.5">
									<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<polyline points="15 17 20 12 15 7"></polyline>
										<path d="M4 18v-2a4 4 0 0 1 4-4h12"></path>
									</svg>
									<span>{ bk.Target }</span>
									<span class={ "px-1 py-px rounded text-[8px] font-bold uppercase tracking-widest",
										templ.KV("bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400", bk.Mode == "sync"),
										templ.KV("bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400", bk.Mode == "async"),
										templ.KV("bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400", bk.Mode == "read-fallback") }>
										{ bk.Mode }
									</span>
								</div>
							}
						}
					}
				</div>
			</div>

			<!-- Folders -->
			<div id="folder-list">
				@FolderList(data.CurrentBucket, data.CurrentPrefix, data.Directories)
			</div>
		</div>
	</aside>
}

templ FolderList(currentBucket string, currentPrefix string, directories []DirectoryInfo) {
	if len(directories) > 0 {
		<div>
			<h3 class="font-semibold text-gray-400 dark:text-gray-500 text-[11px] tracking-widest uppercase mb-3 px-2">Folders</h3>
			<div class="space-y-0.5">
				<!-- All Images link -->
				<button
					hx-get={ fmt.Sprintf("/ui/content?bucket=%s", currentBucket) }
					hx-target="#main-content"
					hx-push-url={ fmt.Sprintf("/dashboard?bucket=%s", currentBucket) }
					class={ "w-full flex items-center gap-2.5 px-3 py-2 rounded-lg transition-all group text-left",
						templ.KV("bg-violet-50 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 font-medium", currentPrefix == ""),
						templ.KV("text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800", currentPrefix != "") }>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={ templ.KV("text-violet-500", currentPrefix == ""), templ.KV("text-gray-400 dark:text-gray-500", currentPrefix != "") }>
						<rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
						<circle cx="9" cy="9" r="2"></circle>
						<path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
					</svg>
					<span class="text-sm">All Images</span>
				</button>

				for _, dir := range directories {
					<button
						hx-get={ fmt.Sprintf("/ui/content?bucket=%s&prefix=%s", currentBucket, dir.Path) }
						hx-target="#main-content"
						hx-push-url={ fmt.Sprintf("/dashboard?bucket=%s&prefix=%s", currentBucket, dir.Path) }
						class={ "w-full flex items-center justify-between px-3 py-2 rounded-lg transition-all group text-left",
							templ.KV("bg-violet-50 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 font-medium", currentPrefix == dir.Path),
							templ.KV("text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800", currentPrefix != dir.Path) }>
						<div class="flex items-center gap-2.5 min-w-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={ templ.KV("text-violet-500", currentPrefix == dir.Path), templ.KV("text-gray-400 dark:text-gray-500", currentPrefix != dir.Path) }>
								<path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"></path>
							</svg>
							<span class="text-sm truncate">{ dir.Name }</span>
						</div>
						<span class={ "text-[10px] font-mono px-1.5 py-0.5 rounded-md",
							templ.KV("bg-violet-100 dark:bg-violet-500/20 text-violet-600 dark:text-violet-300", currentPrefix == dir.Path),
							templ.KV("bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-500", currentPrefix != dir.Path) }>
							{ fmt.Sprintf("%d", dir.FileCount) }
						</span>
					</button>
				}
			</div>
		</div>
	}
}

templ bucketIcon(bucketType string, active bool) {
	switch bucketType {
		case "s3":
			<div class={ "w-7 h-7 rounded-lg flex items-center justify-center text-[9px] font-bold flex-shrink-0",
				templ.KV("bg-orange-100 dark:bg-orange-500/20 text-orange-600 dark:text-orange-300", active),
				templ.KV("bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-500", !active) }>
				S3
			</div>
		case "r2":
			<div class={ "w-7 h-7 rounded-lg flex items-center justify-center text-[9px] font-bold flex-shrink-0",
				templ.KV("bg-orange-100 dark:bg-orange-500/20 text-orange-600 dark:text-orange-300", active),
				templ.KV("bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-500", !active) }>
				R2
			</div>
		default:
			<div class={ "w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0",
				templ.KV("bg-violet-100 dark:bg-violet-500/20 text-violet-600 dark:text-violet-300", active),
				templ.KV("bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-500", !active) }>
				<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"></path>
				</svg>
			</div>
	}
}
