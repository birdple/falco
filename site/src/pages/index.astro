---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';

const base = import.meta.env.BASE_URL;
const github = 'https://github.com/birdple/falco';
const title = 'Falco — upload once, every size instantly';
const description =
  'Falco is an open-source image server you host yourself. Upload a photo once and get any size, crop or format just by changing the link.';

// The landing page sells the idea; the mechanics (env vars, status codes,
// backup modes) live in the docs. Keep jargon out of this file.

// Presets for the hero demo. `fw` is the on-screen width of the frame in px;
// the height follows from the aspect ratio. The same image is cropped around
// the bird in every one, which is what smart cropping looks like.
const presets = [
  { id: 'banner', label: 'Banner', w: 1200, h: 630, fw: 520 },
  { id: 'avatar', label: 'Avatar', w: 400, h: 400, fw: 260 },
  { id: 'mobile', label: 'Mobile', w: 600, h: 900, fw: 213 },
  { id: 'thumb', label: 'Thumbnail', w: 160, h: 160, fw: 120 },
];
const first = presets[0];

const features = [
  {
    title: 'Any size, from a link',
    body: 'Resize, crop, rotate, blur, sharpen or adjust colour. Every variation is just a different URL — nothing is generated ahead of time.',
    icon: 'M4 14v6h6M20 10V4h-6M4 20l7-7M20 4l-7 7',
  },
  {
    title: 'Crops that keep the subject',
    body: 'Smart cropping finds the interesting part of the photo, so a square avatar does not cut off a face.',
    icon: 'M6 2v14a2 2 0 0 0 2 2h14M18 22V8a2 2 0 0 0-2-2H2',
  },
  {
    title: 'Lighter, faster pages',
    body: 'WebP and AVIF out of the box. Every image is served in the format and size the page actually needs.',
    icon: 'M13 2 3 14h8l-1 8 10-12h-8l1-8z',
  },
  {
    title: 'Links nobody can abuse',
    body: 'Signed links that can expire. Only the sizes you created exist, so nobody can make your server render thousands of variations.',
    icon: 'M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4',
  },
  {
    title: 'Your storage, your rules',
    body: 'Keep images on your own disk, Amazon S3, Cloudflare R2 or Jay — with automatic backups to a second location.',
    icon: 'M7 18a5 5 0 1 1 .9-9.9A6 6 0 0 1 19 10a4 4 0 0 1 0 8z',
  },
  {
    title: 'Admin panel included',
    body: 'Browse your images, upload new ones, try transformations live and create signed links — all from the browser.',
    icon: 'M3 4h18v16H3zM3 9h18M9 9v11',
  },
];

const extras = [
  'Watermarks',
  'Duplicate-free uploads',
  'Built-in cache',
  'Rate limiting',
  'Metrics and tracing',
  'Docker and native binaries',
];

const useCases = [
  {
    title: 'Online stores',
    body: 'Product photos for listings, zoom and checkout from a single upload.',
    icon: 'M5 8h14l-1 12H6zM9 8V6a3 3 0 0 1 6 0v2',
  },
  {
    title: 'Community apps',
    body: 'Avatars and user uploads, cropped consistently and served safely.',
    icon: 'M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM2 21a7 7 0 0 1 14 0M17 11a3 3 0 1 0 0-6M22 21a6 6 0 0 0-4-5.6',
  },
  {
    title: 'Blogs and media',
    body: 'Responsive images in every article and share cards for every post.',
    icon: 'M4 4h16v16H4zM8 8h8M8 12h8M8 16h5',
  },
  {
    title: 'Mobile apps',
    body: 'The right resolution for every screen, without shipping five copies.',
    icon: 'M7 2h10v20H7zM11 18h2',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href="https://birdple.github.io/falco/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://birdple.github.io/falco/" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar">
      <a class="wordmark" href={base} aria-label="Falco home">
        <span class="mark" aria-hidden="true"></span>
        <span class="wordmark-text">falco</span>
      </a>
      <nav aria-label="Main">
        <a href="#features">Features</a>
        <a href="#how">How it works</a>
        <a href={`${base}what-falco-is/`}>Docs</a>
        <a class="nav-gh" href={github} rel="noopener">GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Open-source image server</p>
          <h1>Upload once.<br /><span>Every size,</span> instantly.</h1>
          <p class="lede">
            Falco keeps your images and creates any size, crop or format the
            moment you ask for it — just by changing the link. Self-hosted,
            free, and fast.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={`${base}quickstart/`}>Get started</a>
            <a class="btn" href={github} rel="noopener">View on GitHub</a>
          </div>
          <p class="fine">Free and open source · Runs on your own servers · No database to set up</p>
        </div>

        <figure class="demo" data-demo>
          <div class="demo-bar" aria-hidden="true">
            <span class="dots"><i></i><i></i><i></i></span>
            <span class="addr">
              …/images/sunset.webp?w=<b data-w>{first.w}</b>&amp;h=<b data-h>{first.h}</b>
            </span>
          </div>
          <div class="demo-stage">
            <div
              class="frame"
              data-frame
              style={`--fw:${first.fw}px; --ar:${first.w / first.h};`}
            >
              <img
                src={`${base}demo-landscape.svg`}
                alt="A falcon gliding over mountains at sunset, cropped to the selected size"
                width="1600"
                height="1000"
              />
              <span class="dims" data-dims>{first.w} × {first.h}</span>
            </div>
          </div>
          <div class="chips" role="group" aria-label="Pick a size">
            {presets.map((p, i) => (
              <button
                type="button"
                class="chip"
                aria-pressed={i === 0 ? 'true' : 'false'}
                data-w={p.w}
                data-h={p.h}
                data-fw={p.fw}
              >
                {p.label}
              </button>
            ))}
          </div>
          <figcaption>One original. Every size is just a link — nothing is pre-generated.</figcaption>
        </figure>
      </section>

      <section class="backends" aria-label="Supported storage">
        <p>Works with the storage you already have</p>
        <ul>
          <li>Your own disk</li>
          <li>Amazon S3</li>
          <li>Cloudflare R2</li>
          <li>Jay</li>
        </ul>
      </section>

      <section class="section" id="how">
        <p class="kicker">How it works</p>
        <h2>Stop resizing images by hand.</h2>
        <p class="section-lede">
          No more exporting five versions of every photo or writing a thumbnail
          script. Upload the original and let every page ask for exactly what it needs.
        </p>
        <ol class="steps">
          <li>
            <span class="step-n">1</span>
            <h3>Upload it once</h3>
            <p>
              From your app or the admin panel. Falco optimises the image and
              stores it wherever you choose.
            </p>
          </li>
          <li>
            <span class="step-n">2</span>
            <h3>Ask for what you need</h3>
            <p>
              A 400px thumbnail? A square avatar? A WebP for mobile? Change the
              link, not the file.
            </p>
          </li>
          <li>
            <span class="step-n">3</span>
            <h3>Serve it everywhere</h3>
            <p>
              Falco renders it on the first visit and remembers it, so the next
              visitor gets it instantly. Add a CDN and it grows with you.
            </p>
          </li>
        </ol>
      </section>

      <section class="section" id="features">
        <p class="kicker">Features</p>
        <h2>Everything your images need, in one place.</h2>
        <div class="grid">
          {features.map((f) => (
            <article class="card">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={f.icon} /></svg>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
        <ul class="extras" aria-label="Also included">
          {extras.map((e) => <li>{e}</li>)}
        </ul>
      </section>

      <section class="section">
        <p class="kicker">Made for</p>
        <h2>Anywhere images matter.</h2>
        <div class="uses">
          {useCases.map((u) => (
            <article class="use">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={u.icon} /></svg>
              <div>
                <h3>{u.title}</h3>
                <p>{u.body}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section why">
        <p class="kicker">Why Falco</p>
        <h2>Your images. Your servers. No surprises.</h2>
        <div class="why-grid">
          <div>
            <h3>You own everything</h3>
            <p>
              Your images live on your infrastructure. Nothing is sent to a
              third party, and you can leave whenever you want.
            </p>
          </div>
          <div>
            <h3>No per-image bill</h3>
            <p>
              Hosted image services charge by the transformation. Falco is free
              and open source: the only cost is the server you already run.
            </p>
          </div>
          <div>
            <h3>One service instead of three</h3>
            <p>
              Uploads, storage and resizing usually mean three tools and glue
              code between them. Falco does all of it, with one set of keys.
            </p>
          </div>
        </div>
        <p class="why-links">
          <a href={`${base}internals/vs-imgproxy/`}>How it compares to imgproxy →</a>
          <a href={`${base}what-falco-is/`}>What Falco is, and is not →</a>
        </p>
      </section>

      <section class="cta">
        <div class="cta-inner">
          <h2>Up and running in about a minute.</h2>
          <p>
            One container, no database. Try it on your laptop today and move it
            to production when you are ready.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={`${base}quickstart/`}>Get started</a>
            <a class="btn" href={github} rel="noopener">Star on GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <p>Open source under GPLv3. Built by <a href="https://github.com/ivangsm" rel="noopener">Iván Salazar</a>.</p>
      <nav aria-label="Footer">
        <a href={`${base}quickstart/`}>Quickstart</a>
        <a href={`${base}what-falco-is/`}>Docs</a>
        <a href={`${base}reference/http-api/`}>API</a>
        <a href={github} rel="noopener">GitHub</a>
      </nav>
    </footer>

    <script>
      const demo = document.querySelector('[data-demo]');
      if (demo) {
        const frame = demo.querySelector<HTMLElement>('[data-frame]')!;
        const dims = demo.querySelector('[data-dims]')!;
        const outW = demo.querySelector('[data-w]')!;
        const outH = demo.querySelector('[data-h]')!;
        const chips = demo.querySelectorAll<HTMLButtonElement>('.chip');
        chips.forEach((chip) => {
          chip.addEventListener('click', () => {
            const { w, h, fw } = chip.dataset;
            frame.style.setProperty('--fw', `${fw}px`);
            frame.style.setProperty('--ar', String(Number(w) / Number(h)));
            dims.textContent = `${w} × ${h}`;
            outW.textContent = w ?? '';
            outH.textContent = h ?? '';
            chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
          });
        });
      }
    </script>
  </body>
</html>

<style>
	:root {
		--ink: #1b1714;
		--ink-2: #241e18;
		--ink-3: #362c21;
		--amber: #e08b3c;
		--amber-bright: #f0b562;
		--amber-deep: #c2762f;
		--sand: #e8d5b5;
		--paper: #faf6f0;
		--text-2: #d6c8b6;
		--muted: #a3927c;
		--line: #3a2f23;
		--radius: 14px;
		--wrap: 1140px;
		color-scheme: dark;
	}

	* { box-sizing: border-box; }

	html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

	body {
		margin: 0;
		background: var(--ink);
		color: var(--paper);
		font-family: 'IBM Plex Sans', system-ui, -apple-system, sans-serif;
		font-size: 16px;
		line-height: 1.6;
	}

	a { color: var(--amber-bright); text-decoration-thickness: 1px; text-underline-offset: 3px; }
	a:hover { color: var(--paper); }
	h1, h2, h3 { font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }

	:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }

	.skip {
		position: absolute; left: -9999px;
		background: var(--paper); color: var(--ink); padding: 0.5rem 1rem;
	}
	.skip:focus { left: 1rem; top: 1rem; z-index: 10; }

	/* ---------- top bar ---------- */
	.topbar {
		display: flex; align-items: center; justify-content: space-between;
		gap: 1rem 2rem; flex-wrap: wrap;
		max-width: var(--wrap); margin: 0 auto; padding: 1.25rem 1.5rem;
	}
	.wordmark { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--paper); }
	.wordmark-text { font-size: 1.35rem; font-weight: 600; letter-spacing: -0.04em; }
	/* Crop marks around a frame — the service in one glyph. */
	.mark {
		width: 26px; height: 26px; flex: none; position: relative;
		border-left: 2px solid var(--amber); border-right: 2px solid var(--amber);
	}
	.mark::before, .mark::after {
		content: ''; position: absolute; left: -4px; right: -4px; height: 2px;
		background: var(--amber);
	}
	.mark::before { top: 5px; }
	.mark::after { bottom: 5px; }

	.topbar nav { display: flex; align-items: center; gap: 1.5rem; font-size: 0.9375rem; flex-wrap: wrap; }
	.topbar nav a { color: var(--muted); text-decoration: none; }
	.topbar nav a:hover { color: var(--paper); }
	.topbar nav .nav-gh {
		color: var(--paper); border: 1px solid var(--ink-3); border-radius: 999px;
		padding: 0.3rem 0.9rem;
	}
	.topbar nav .nav-gh:hover { border-color: var(--amber); }

	/* ---------- hero ---------- */
	.hero {
		position: relative;
		max-width: var(--wrap); margin: 0 auto; padding: 4.5rem 1.5rem 4rem;
		display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;
	}
	.hero::before {
		content: ''; position: absolute; z-index: -1; pointer-events: none;
		width: min(720px, 100%); aspect-ratio: 1; right: 0; top: -200px;
		background: radial-gradient(closest-side, rgba(224, 139, 60, 0.22), transparent);
	}
	.eyebrow, .kicker {
		margin: 0 0 1rem; font-size: 0.8125rem; font-weight: 600;
		letter-spacing: 0.08em; text-transform: uppercase; color: var(--amber);
	}
	.hero h1 {
		font-size: clamp(2.4rem, 5.4vw, 4rem);
		letter-spacing: -0.04em; line-height: 1.02; margin: 0 0 1.5rem;
	}
	.hero h1 span {
		background: linear-gradient(90deg, var(--amber-bright), var(--amber));
		-webkit-background-clip: text; background-clip: text; color: transparent;
	}
	.lede { font-size: 1.1875rem; color: var(--text-2); margin: 0 0 2rem; max-width: 46ch; }
	.fine { margin: 1.5rem 0 0; font-size: 0.875rem; color: var(--muted); }

	.actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
	.btn {
		display: inline-block; padding: 0.75rem 1.4rem;
		border: 1px solid var(--ink-3); border-radius: 999px;
		color: var(--paper); text-decoration: none; font-size: 0.9875rem; font-weight: 600;
		transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
	}
	.btn:hover { background: var(--ink-2); border-color: var(--amber); color: var(--paper); transform: translateY(-1px); }
	.btn-primary { background: var(--amber); border-color: var(--amber); color: var(--ink); }
	.btn-primary:hover { background: var(--amber-bright); border-color: var(--amber-bright); color: var(--ink); }

	/* ---------- hero demo ---------- */
	.demo {
		margin: 0; background: var(--ink-2); border: 1px solid var(--line);
		border-radius: var(--radius); overflow: hidden;
		box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.7);
	}
	.demo-bar {
		display: flex; align-items: center; gap: 0.75rem;
		padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--line);
	}
	.dots { display: flex; gap: 6px; flex: none; }
	.dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--ink-3); }
	.addr {
		flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
		background: var(--ink); border-radius: 999px; padding: 0.3rem 0.8rem;
		font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 0.8125rem; color: var(--muted);
	}
	.addr b { color: var(--amber-bright); font-weight: 500; }
	.demo-stage {
		--stage-h: 320px;
		height: calc(var(--stage-h) + 2.5rem); padding: 1.25rem;
		display: grid; place-items: center;
		background:
			linear-gradient(45deg, var(--ink) 25%, transparent 25%, transparent 75%, var(--ink) 75%) 0 0 / 20px 20px,
			linear-gradient(45deg, var(--ink) 25%, transparent 25%, transparent 75%, var(--ink) 75%) 10px 10px / 20px 20px,
			#201a15;
	}
	.frame {
		position: relative; aspect-ratio: var(--ar);
		width: min(100%, var(--fw), calc(var(--stage-h) * var(--ar)));
		border-radius: 8px; overflow: hidden;
		outline: 2px solid var(--amber); outline-offset: 3px;
		transition: width 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.frame img {
		display: block; width: 100%; height: 100%;
		object-fit: cover; object-position: 62% 40%;
	}
	.dims {
		position: absolute; right: 6px; bottom: 6px;
		background: rgba(27, 23, 20, 0.8); color: var(--paper);
		font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 0.6875rem;
		padding: 0.1rem 0.45rem; border-radius: 4px;
	}
	.chips {
		display: flex; flex-wrap: wrap; gap: 0.5rem;
		padding: 0.9rem; border-top: 1px solid var(--line);
	}
	.chip {
		font: inherit; font-size: 0.875rem; cursor: pointer;
		background: transparent; color: var(--text-2);
		border: 1px solid var(--ink-3); border-radius: 999px; padding: 0.35rem 0.9rem;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}
	.chip:hover { border-color: var(--amber); color: var(--paper); }
	.chip[aria-pressed='true'] { background: var(--amber); border-color: var(--amber); color: var(--ink); font-weight: 600; }
	.demo figcaption { padding: 0 0.9rem 0.9rem; font-size: 0.8125rem; color: var(--muted); }

	/* ---------- storage strip ---------- */
	.backends {
		border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
		max-width: var(--wrap); margin: 0 auto; padding: 1.5rem;
		display: flex; align-items: center; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap;
	}
	.backends p { margin: 0; color: var(--muted); font-size: 0.9375rem; }
	.backends ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.75rem 2.5rem; flex-wrap: wrap; }
	.backends li { font-weight: 600; color: var(--sand); letter-spacing: -0.01em; }

	/* ---------- sections ---------- */
	.section { max-width: var(--wrap); margin: 0 auto; padding: 5.5rem 1.5rem 1rem; }
	.section h2, .cta h2 { font-size: clamp(1.8rem, 3.6vw, 2.6rem); margin: 0 0 1rem; max-width: 22ch; letter-spacing: -0.03em; }
	.section-lede { font-size: 1.125rem; color: var(--text-2); max-width: 60ch; margin: 0 0 3rem; }
	.section > h2:last-of-type { margin-bottom: 2.5rem; }
	.section > .section-lede + * { margin-top: 0; }

	.icon {
		width: 26px; height: 26px; flex: none;
		fill: none; stroke: var(--amber-bright); stroke-width: 1.6;
		stroke-linecap: round; stroke-linejoin: round;
	}

	/* how it works */
	.steps {
		list-style: none; margin: 0; padding: 0;
		display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
	}
	.steps li {
		background: var(--ink-2); border: 1px solid var(--line); border-radius: var(--radius);
		padding: 1.75rem;
	}
	.step-n {
		display: grid; place-items: center; width: 2.25rem; height: 2.25rem; margin-bottom: 1.25rem;
		border-radius: 50%; background: rgba(224, 139, 60, 0.15); color: var(--amber-bright);
		font-weight: 600;
	}
	.steps h3 { font-size: 1.1875rem; margin: 0 0 0.5rem; }
	.steps p { margin: 0; color: var(--text-2); }

	/* features */
	.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
	.card {
		background: var(--ink-2); border: 1px solid var(--line); border-radius: var(--radius);
		padding: 1.75rem; transition: border-color 0.15s ease, transform 0.15s ease;
	}
	.card:hover { border-color: var(--amber-deep); transform: translateY(-2px); }
	.card h3 { font-size: 1.125rem; margin: 1rem 0 0.5rem; }
	.card p { margin: 0; color: var(--text-2); font-size: 0.9875rem; }

	.extras { list-style: none; margin: 1.75rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
	.extras li {
		font-size: 0.875rem; color: var(--text-2);
		border: 1px solid var(--line); border-radius: 999px; padding: 0.35rem 0.9rem;
	}

	/* use cases */
	.uses { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem 3rem; }
	.use { display: flex; gap: 1rem; padding: 1.25rem 0; border-top: 1px solid var(--line); }
